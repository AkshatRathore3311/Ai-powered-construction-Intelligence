# BuildIntel AI — Backend Environment Configuration

# Application
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Multimodal AI Provider (gemini or openai)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# Weather API (Optional: system automatically uses live Open-Meteo telemetry if omitted)
WEATHER_API_KEY=
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
DEFAULT_CITY_NAME="Metro Hub Sector 62"

# Supabase (PostgreSQL, Storage, Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=inspection-assets
